<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.vc3recomp.vulkanprobe">
<uses-sdk android:minSdkVersion="29" android:targetSdkVersion="32"/>
<uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true"/>
<uses-permission android:name="org.khronos.openxr.permission.OPENXR"/>
<uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM"/>
<queries><provider android:name="org.khronos.openxr.RuntimeBroker" android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker"/><intent><action android:name="org.khronos.openxr.OpenXRRuntimeService"/></intent></queries>
<application android:label="Vulkan runtime probe" android:hasCode="false" android:extractNativeLibs="true" android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
<meta-data android:name="com.oculus.supportedDevices" android:value="quest2|quest3|quest3s|questpro"/>
<meta-data android:name="com.oculus.intent.category.VR" android:value="vr_only"/>
<activity android:name="android.app.NativeActivity" android:exported="true" android:screenOrientation="landscape" android:configChanges="orientation|screenSize|keyboardHidden">
<meta-data android:name="android.app.lib_name" android:value="ch_vk_probe"/>
<intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/><category android:name="com.oculus.intent.category.VR"/></intent-filter>
</activity></application></manifest>
