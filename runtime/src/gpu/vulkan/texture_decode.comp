#version 450
#extension GL_GOOGLE_include_directive : require
#include "morton.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(std430,set=0,binding=0) buffer Storage {uint words[];} data;
layout(push_constant) uniform Params {uint width,height,pitch,flags;} pc;
void main() {
    uint x=gl_GlobalInvocationID.x,y=gl_GlobalInvocationID.y;
    if(x>=pc.width || y>=pc.height) return;
    uint at=y*pc.pitch+x;
    if((pc.flags&1u)!=0u) {
        at=ch_morton_index(x,y,pc.width,pc.height);
    }
    uint word=data.words[pc.width*pc.height+at];
    uint order=pc.flags>>2;
    if(order==1u) word=(word&0xff00ff00u)|((word&255u)<<16)|((word>>16)&255u);
    else if(order==2u) word=((word&255u)<<24)|((word&0xff00u)<<8)|((word>>8)&0xff00u)|(word>>24);
    else if(order==3u) word=(word<<24)|(word>>8);
    if((pc.flags&2u)!=0u) word|=0xff000000u;
    data.words[y*pc.width+x]=(word&0xff00ff00u)|((word&255u)<<16)|((word>>16)&255u);
}
