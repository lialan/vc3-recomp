#version 450
#extension GL_GOOGLE_include_directive : require
#include "morton.glsl"
layout(local_size_x=64) in;
layout(std430,set=0,binding=0) buffer Storage {uint words[];} data;
layout(set=0,binding=1) uniform sampler2D color_image;
layout(push_constant) uniform Params {uint count;uint width;uint height;uint morton;} pc;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=pc.count) return;
    ivec2 xy=ivec2(i%pc.width,i/pc.width);
    uint at=pc.morton!=0u?pc.count+ch_morton_linear_index(i,pc.width,pc.height):i;
    uvec4 c=uvec4(roundEven(texelFetch(color_image,xy,0)*255.0));
    data.words[at]=c.b|(c.g<<8)|(c.r<<16)|(c.a<<24);
}
