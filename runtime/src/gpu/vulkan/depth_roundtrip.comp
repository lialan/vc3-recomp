#version 450
#extension GL_GOOGLE_include_directive : require
#include "depth_quant.glsl"
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) buffer Depth { float values[]; } data;
layout(push_constant) uniform Count { uint count; } pc;
void main(){uint i=gl_GlobalInvocationID.x;if(i<pc.count)data.values[i]=ch_depth_unpack(ch_depth_pack(data.values[i]));}
