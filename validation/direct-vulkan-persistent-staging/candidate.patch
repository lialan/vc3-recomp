+/* Persistent mappings do not change synchronization: callers still wait for
+ * GPU writes before invalidating/reading, and flush host writes before submit. */
+static VkResult staging_cache(ChVkTarget *t,const VkMappedMemoryRange *range,int upload) {
+    int coherent=range->memory==t->read_mem?t->read_coherent:t->paired_color_coherent;
+    if(coherent) return VK_SUCCESS;
+    return upload?vkFlushMappedMemoryRanges(t->device,1,range):vkInvalidateMappedMemoryRanges(t->device,1,range);
+}
