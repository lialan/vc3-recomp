     s_proxy.flip = real->flip ? p_flip : NULL;
     s_proxy.draw_raw = real->draw_raw ? p_draw_raw : NULL;
     s_proxy.flush = real->flush ? p_flush : NULL;
+    s_proxy.raw_no_extent = real->raw_no_extent;
     return &s_proxy;
 }
