+/* Temporary local performance probe; archived and removed after diagnosis. */
+static _Thread_local struct {uint64_t wall,cpu,polls,checks,calls,done;} mw_probe;
+static uint64_t mw_clock(clockid_t id) {
+    struct timespec t;clock_gettime(id,&t);return (uint64_t)t.tv_sec*1000000000ull+t.tv_nsec;
